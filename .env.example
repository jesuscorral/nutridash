# Gemini AI API key (required only for AI features)
# Get it free at https://aistudio.google.com
# You can also set this from the Settings page in the app
GEMINI_API_KEY=your_key_here

# PostgreSQL development container settings
# docker-compose.yml derives the app connection string from these values
POSTGRES_DB=nutridash
POSTGRES_USER=nutridash
POSTGRES_PASSWORD=nutridash_dev_password
