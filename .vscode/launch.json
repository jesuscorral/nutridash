{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NutriDash: Debug (watch)",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "nutridash: watch",
      "processName": "NutriDash.Web",
      "justMyCode": true,
      "requireExactSource": false
    },
    {
      "name": "NutriDash: Debug (run)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "nutridash: prepare debug",
      "program": "${workspaceFolder}/src/NutriDash.Web/bin/Debug/net10.0/NutriDash.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/NutriDash.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7080;http://localhost:5080",
        "ConnectionStrings__DefaultConnection": "Host=localhost;Port=5432;Database=nutridash;Username=nutridash;Password=nutridash_dev_password;Include Error Detail=true",
        "GEMINI_API_KEY": ""
      },
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "NutriDash: Attach to process",
      "type": "coreclr",
      "request": "attach",
      "processName": "NutriDash.Web"
    }
  ],
  "compounds": [
    {
      "name": "NutriDash: Full Stack (watch + browser)",
      "configurations": [
        "NutriDash: Debug (watch)"
      ],
      "stopAll": true
    }
  ]
}
